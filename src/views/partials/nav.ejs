<header class="topbar">
  <div class="topbar-brand">
    <a href="/" class="topbar-brand-link">
      <img src="/images/sari-sari-logo.png" alt="Sari-Sari POS Logo" class="topbar-logo" />
      <span>Sari-Sari POS</span>
    </a>
  </div>
  <nav class="topbar-nav">
    <% if (currentUser && currentUser.role === 'admin') { %>
      <a href="/admin/dashboard" class="<%= typeof title !== 'undefined' && title === 'Dashboard' ? 'active' : '' %>">Dashboard</a>
      <a href="/admin/products" class="<%= typeof title !== 'undefined' && title === 'Products' ? 'active' : '' %>">
        Products
        <% if (typeof lowStockCount !== 'undefined' && lowStockCount > 0) { %>
          <span class="nav-alert-pill" title="<%= lowStockCount %> items low or out of stock"><%= lowStockCount %></span>
        <% } %>
      </a>
      <a href="/admin/sales" class="<%= typeof title !== 'undefined' && (title === 'Sales' || title === 'Sale Detail') ? 'active' : '' %>">Sales</a>
      <a href="/admin/inventory-reports" class="<%= typeof title !== 'undefined' && title === 'Inventory Reports' ? 'active' : '' %>">Inventory Reports</a>
      <a href="/admin/users" class="<%= typeof title !== 'undefined' && title === 'Users' ? 'active' : '' %>">Users</a>
    <% } else if (currentUser && currentUser.role === 'sales_rep') { %>
      <a href="/pos" class="<%= typeof title !== 'undefined' && title === 'Point of Sale' ? 'active' : '' %>">Point of Sale</a>
      <a href="/pos/inventory" class="<%= typeof title !== 'undefined' && title === 'Inventory' ? 'active' : '' %>">Inventory</a>
    <% } %>
  </nav>
  <div class="topbar-user">
    <% if (currentUser) { %>
      <span class="user-badge"><%= currentUser.fullName %> <small>(<%= currentUser.role === 'admin' ? 'Admin' : 'Sales Rep' %>)</small></span>
      <form method="POST" action="/logout" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="logout-btn">Logout</button>
      </form>
    <% } %>
  </div>
</header>
<% if (flash && flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
<% if (flash && flash.error) { %><div class="alert alert-error"><%= flash.error %></div><% } %>
