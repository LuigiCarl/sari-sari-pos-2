<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <h1>Inventory</h1>

  <div class="card">
    <h2>Submit Inventory Report</h2>
    <form method="POST" action="/pos/inventory/report" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Product
        <select name="product_id" required>
          <% products.forEach(p => { %>
            <option value="<%= p.id %>"><%= p.name %> (<%= p.stock_quantity %> <%= p.unit %> in stock)</option>
          <% }) %>
        </select>
      </label>
      <label>Type
        <select name="type" required>
          <option value="restock">Restock (received new stock)</option>
          <option value="damaged">Damaged</option>
          <option value="lost">Lost / Missing</option>
          <option value="correction">Correction</option>
        </select>
      </label>
      <label>Quantity <input type="number" name="quantity" min="1" required /></label>
      <label>Note <input type="text" name="note" placeholder="Optional remarks" /></label>
      <button type="submit" class="btn btn-primary">Submit Report</button>
    </form>
  </div>

  <div class="card">
    <h2>Current Stock</h2>
    <table class="table">
      <thead><tr><th>Product</th><th>Stock</th><th>Reorder Level</th></tr></thead>
      <tbody>
        <% products.forEach(p => { %>
          <tr class="<%= p.stock_quantity <= p.reorder_level ? 'row-warning' : '' %>">
            <td><%= p.name %></td>
            <td><%= p.stock_quantity %> <%= p.unit %></td>
            <td><%= p.reorder_level %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2>My Recent Reports</h2>
    <% if (myReports.length === 0) { %>
      <p class="muted">You haven't submitted any reports yet.</p>
    <% } else { %>
      <table class="table">
        <thead><tr><th>Product</th><th>Type</th><th>Change</th><th>Note</th><th>When</th></tr></thead>
        <tbody>
          <% myReports.forEach(r => { %>
            <tr>
              <td><%= r.product_name %></td>
              <td><%= r.type %></td>
              <td><%= r.quantity_change > 0 ? '+' : '' %><%= r.quantity_change %></td>
              <td><%= r.note || '—' %></td>
              <td><%= r.created_at %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</main>
<%- include('../partials/foot') %>
