<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container pos-layout">
  <div class="pos-products">
    <div class="pos-header-row">
      <h1>Point of Sale</h1>
      <span class="pos-hint-tag">⚡ Shortcuts: <strong>F2</strong> Search · <strong>Enter</strong> Add · <strong>F4</strong> Pay</span>
    </div>

    <div class="pos-search-wrap">
      <input type="search" id="productSearch" placeholder="Search product name or scan barcode (F2)..." autocomplete="off" autofocus />
    </div>

    <div class="category-pills" id="categoryPills">
      <button type="button" class="category-pill active" data-category="all">All</button>
      <% if (typeof categories !== 'undefined') { %>
        <% categories.forEach(c => { %>
          <button type="button" class="category-pill" data-category="<%= c.id %>"><%= c.name %></button>
        <% }) %>
      <% } %>
    </div>

    <div class="product-grid" id="productGrid">
      <% products.forEach(p => { %>
        <button
          type="button"
          class="product-tile"
          data-id="<%= p.id %>"
          data-name="<%= p.name %>"
          data-price="<%= p.selling_price %>"
          data-stock="<%= p.stock_quantity %>"
          data-unit="<%= p.unit %>"
          data-category="<%= p.category_id || '' %>"
          data-barcode="<%= p.barcode || '' %>"
        >
          <span class="product-name"><%= p.name %></span>
          <span class="product-price"><%= peso(p.selling_price) %></span>
          <span class="product-stock"><%= p.stock_quantity %> <%= p.unit %> left</span>
        </button>
      <% }) %>
    </div>
  </div>

  <div class="pos-cart">
    <h2>Cart</h2>
    <table class="table" id="cartTable">
      <thead><tr><th>Item</th><th>Price</th><th>Qty</th><th>Subtotal</th><th></th></tr></thead>
      <tbody id="cartBody"></tbody>
    </table>
    <div class="cart-total">Total: <span id="cartTotal">₱0.00</span></div>

    <form method="POST" action="/pos/checkout" id="checkoutForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="items" id="itemsInput" />
      
      <label for="amountPaid">Amount Paid (F4)
        <input type="number" step="0.01" min="0" name="amount_paid" id="amountPaid" placeholder="0.00" required />
      </label>

      <div class="quick-cash-group">
        <span class="quick-cash-label">Quick Cash:</span>
        <div class="quick-cash-buttons" id="quickCashButtons">
          <button type="button" class="quick-cash-btn" data-action="exact">Exact</button>
          <button type="button" class="quick-cash-btn" data-cash="50">₱50</button>
          <button type="button" class="quick-cash-btn" data-cash="100">₱100</button>
          <button type="button" class="quick-cash-btn" data-cash="200">₱200</button>
          <button type="button" class="quick-cash-btn" data-cash="500">₱500</button>
          <button type="button" class="quick-cash-btn" data-cash="1000">₱1,000</button>
        </div>
      </div>

      <div class="cart-change">Change: <span id="changeAmount">₱0.00</span></div>
      <button type="submit" class="btn btn-primary btn-block" id="checkoutBtn" disabled>Complete Sale</button>
    </form>
  </div>
</main>
<script src="/js/pos.js"></script>
<%- include('../partials/foot') %>
