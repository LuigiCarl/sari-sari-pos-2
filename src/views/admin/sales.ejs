<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <div class="pos-header-row">
    <h1>Sales Transactions</h1>
    <a href="/admin/sales/export.csv?from=<%= from %>&to=<%= to %>" class="btn btn-secondary btn-export" id="exportSalesBtn">📥 Export CSV</a>
  </div>

  <div class="card">
    <form method="GET" action="/admin/sales" class="form-inline">
      <label>From <input type="date" name="from" value="<%= from %>" /></label>
      <label>To <input type="date" name="to" value="<%= to %>" /></label>
      <button type="submit" class="btn btn-secondary">Filter</button>
      <a href="/admin/sales" class="btn btn-small">Clear</a>
    </form>
  </div>

  <div class="card">
    <% if (sales.length === 0) { %>
      <p class="muted">No transactions found.</p>
    <% } else { %>
      <div class="table-scroll">
        <table class="table">
          <thead><tr><th>Receipt</th><th>Cashier</th><th>Total</th><th>Paid</th><th>Change</th><th>When</th></tr></thead>
          <tbody>
            <% sales.forEach(s => { %>
              <tr>
                <td><a href="/admin/sales/<%= s.id %>" class="receipt-code"><%= s.receipt_no %></a></td>
                <td><%= s.cashier %></td>
                <td><strong><%= peso(s.total_amount) %></strong></td>
                <td><%= peso(s.amount_paid) %></td>
                <td><%= peso(s.change_amount) %></td>
                <td class="text-nowrap text-muted"><%= formatDateTime(s.created_at) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>
<%- include('../partials/foot') %>
